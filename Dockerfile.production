# syntax=docker/dockerfile:1
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONPATH="/app/bhumi-setu/apps/api:/app/bhumi-setu:/app/bhumi-setu/ml/src"

WORKDIR /app

# Install system dependencies
RUN apt-get update \
    && apt-get install --no-install-recommends -y curl \
    && rm -rf /var/lib/apt/lists/*

# Install python dependencies
COPY bhumi-setu/apps/api/requirements.txt ./requirements.txt
RUN pip install -r requirements.txt

# Copy application, ml libraries, and frozen model artifacts
COPY bhumi-setu /app/bhumi-setu
COPY models /app/models
COPY data/real_data/clean /app/data/real_data/clean

# Non-root user
RUN useradd --create-home --uid 10001 bhumisetu \
    && chown -R bhumisetu:bhumisetu /app
USER bhumisetu

WORKDIR /app/bhumi-setu/apps/api

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
