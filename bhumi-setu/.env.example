# BHUMISETU Environment Configuration Template
# Copy this file to .env and fill in the values

# ==========================================
# Application Settings
# ==========================================
APP_NAME=bhumisetu
APP_ENV=development
APP_DEBUG=true
APP_PORT=8000
APP_LOG_LEVEL=info

# ==========================================
# Database Configuration
# ==========================================
DATABASE_URL=postgresql://bhumisetu:password@localhost:5432/bhumisetu_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false

# PostGIS Extension
POSTGIS_ENABLED=true

# ==========================================
# Redis Configuration
# ==========================================
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600
REDIS_SESSION_TTL=1800

# ==========================================
# Authentication
# ==========================================
JWT_SECRET_KEY=change-this-to-a-secure-random-string
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# ==========================================
# Security
# ==========================================
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
RATE_LIMIT_PER_MINUTE=100
BCRYPT_ROUNDS=12

# ==========================================
# Celery / Task Queue
# ==========================================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_SOFT_TIME_LIMIT=300
CELERY_TASK_TIME_LIMIT=600

# ==========================================
# File Storage
# ==========================================
UPLOAD_DIR=/var/lib/bhumisetu/uploads
MAX_UPLOAD_SIZE_MB=50
ALLOWED_FILE_TYPES=pdf,jpg,jpeg,png,tiff

# ==========================================
# OCR Configuration
# ==========================================
OCR_ENGINE=tesseract
OCR_LANGUAGES=eng,hin,mar
OCR_DPI=300

# ==========================================
# ML / Prediction
# ==========================================
ML_MODEL_PATH=/var/lib/bhumisetu/models
ML_PREDICTION_CACHE_TTL=86400

# ==========================================
# Email / SMS (Notifications)
# ==========================================
SMTP_HOST=smtp.gov.in
SMTP_PORT=587
SMTP_USER=noreply@bhumisetu.gov.in
SMTP_PASSWORD=change-this
SMTP_USE_TLS=true

SMS_PROVIDER=gov_sms_gateway
SMS_API_KEY=change-this
SMS_SENDER_ID=BHMSETU

# ==========================================
# Logging
# ==========================================
LOG_FORMAT=json
LOG_FILE=/var/log/bhumisetu/app.log
LOG_ROTATION=daily
LOG_RETENTION_DAYS=30

# ==========================================
# Feature Flags
# ==========================================
FEATURE_AI_DOCUMENT_VERIFICATION=true
FEATURE_COMPENSATION_CALCULATOR=true
FEATURE_GIS_MAP=true
FEATURE_CITIZEN_PORTAL=true
FEATURE_ML_PREDICTIONS=false
