{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListHoldoutBucket",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::bhumisetu-holdout"
      ]
    },
    {
      "Sid": "ReadHoldoutObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::bhumisetu-holdout/*"
      ]
    }
  ]
}
